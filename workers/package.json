{
  "name": "kospi-bets-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:create": "wrangler d1 create kospi-bets",
    "db:migrate": "wrangler d1 execute kospi-bets --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute kospi-bets --remote --file=migrations/0001_init.sql",
    "db:console": "wrangler d1 execute kospi-bets --command \"SELECT name FROM sqlite_master WHERE type='table';\"",
    "types": "wrangler types",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5",
    "wrangler": "latest"
  }
}
